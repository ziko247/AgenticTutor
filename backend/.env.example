# Copy to backend/.env, or use tools/setup_local.py after the local stack starts.
# The setup tool generates this password locally; no administrator DSN in the API.
DATABASE_URL=postgresql://app_runtime:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:58422/postgres
DATABASE_POOL_SIZE=4
DATABASE_TIMEOUT=2
CORS_ORIGINS=["http://127.0.0.1:3000"]

SUPABASE_URL=http://127.0.0.1:58421
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
